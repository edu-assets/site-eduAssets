---
import BaseLayout from '../layouts/BaseLayout.astro';
import LandingPage from '../features/landing/LandingPage.astro';
import { ptBr } from '../features/landing/content/pt-br';
import { softwareApplicationJsonLd } from '../core/seo/jsonld';

const description = 'Sistema de controle de empréstimos e inventário de equipamentos escolares: empréstimos, devoluções, ocorrências e login por cartão RFID.';
---
<BaseLayout title="eduAssets — controle de equipamentos escolares" description={description} alternates={['pt-br', 'en']} jsonLd={softwareApplicationJsonLd(description)}>
  <LandingPage locale="pt-br" content={ptBr} />
</BaseLayout>
