---
import Section from '../../../shared/components/Section.astro';
import Icon from '../../../shared/components/Icon.astro';
import IconBadge from '../../../shared/components/IconBadge.astro';
import type { LandingContent } from '../content/types';
const { access } = Astro.props as { access: LandingContent['access'] };
---
<Section id="access" eyebrow={access.eyebrow} title={access.title} lead={access.lead} tone="alt">
  <div class="access">
    <ul class="levels" role="list">
      {access.levels.map((l) => (
        <li>
          <IconBadge name={l.icon} />
          <div><h3>{l.name}</h3><p>{l.can}</p></div>
        </li>
      ))}
    </ul>
    <div class="security">
      <h3>{access.securityTitle}</h3>
      <ul class="ticks" role="list">
        {access.security.map((s) => <li><Icon name="verified_user" />{s}</li>)}
      </ul>
    </div>
  </div>
</Section>
