---
import Button from '../../../shared/components/Button.astro';
import Screenshot from '../../../shared/components/Screenshot.astro';
import { APP_URL, GITHUB_URL } from '../../../core/config/site';
import type { LandingContent } from '../content/types';
const { hero } = Astro.props as { hero: LandingContent['hero'] };
---
<section class="hero">
  <div class="container hero__inner">
    <div class="hero__text">
      <h1>{hero.title}</h1>
      <p class="hero__lead">{hero.lead}</p>
      <div class="hero__actions">
        <Button href={APP_URL}>{hero.primary}</Button>
        <Button href={GITHUB_URL} variant="secondary" external>{hero.secondary}</Button>
      </div>
      <p class="hero__note">{hero.note}</p>
    </div>
    <Screenshot label={hero.shot.label} hint={hero.shot.hint} />
  </div>
</section>
