---
import Section from '../../../shared/components/Section.astro';
import Icon from '../../../shared/components/Icon.astro';
import IconBadge from '../../../shared/components/IconBadge.astro';
import Photo from '../../../shared/components/Photo.astro';
import type { LandingContent } from '../content/types';
const { project } = Astro.props as { project: LandingContent['project'] };
---
<Section id="project" eyebrow={project.eyebrow} title={project.title} lead={project.lead} tone="alt">
  <div class="project-challenge">
    <article class="project-challenge__card">
      <div class="project-card__heading">
        <IconBadge name={project.challenge.icon} tone="warning" size="lg" />
        <h3>{project.challenge.title}</h3>
      </div>
      <p>{project.challenge.text}</p>
      <Photo name="carrinho-notebooks" ratio="16 / 9" alt={project.challenge.photo.alt} caption={project.challenge.photo.caption} />
      <h4 class="project-questions-title">{project.challenge.questionsTitle}</h4>
      <ul class="project-questions" role="list">
        {project.challenge.questions.map((question, index) => (
          <li>
            <span class="project-question__index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <IconBadge name={question.icon} tone="neutral" />
            <span class="project-question__text">{question.text}</span>
          </li>
        ))}
      </ul>
    </article>
    <article class="project-solution">
      <div class="project-card__heading">
        <IconBadge name={project.solution.icon} tone="success" size="lg" />
        <h3>{project.solution.title}</h3>
      </div>
      <p>{project.solution.text}</p>
    </article>
  </div>

  <div class="project-block">
    <h3>{project.scopeTitle}</h3>
    <ul class="project-scope" role="list">
      {project.scope.map((item, index) => (
        <li class:list={{ 'project-scope__item--featured': index < 3 }}>
          <span class="project-scope__index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <IconBadge name={item.icon} tone="neutral" />
          <div><strong>{item.title}</strong><p>{item.text}</p></div>
        </li>
      ))}
    </ul>
  </div>

  <div class="project-block project-block--decisions">
    <h3>{project.decisionsTitle}</h3>
    <ul class="project-decisions" role="list">
      {project.decisions.map((item) => (
        <li>
          <span class="project-decision__icon"><Icon name={item.icon} /></span>
          <div><strong>{item.title}</strong><p>{item.text}</p></div>
        </li>
      ))}
    </ul>
  </div>
</Section>

<script>
  const scope = document.querySelector<HTMLElement>('.project-scope');
  const cards = scope ? Array.from(scope.querySelectorAll<HTMLElement>(':scope > li')) : [];
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (scope && cards.length > 0) {
    if (reduceMotion || !('IntersectionObserver' in window)) {
      cards.forEach((card) => card.classList.add('is-visible'));
    } else {
      scope.classList.add('project-scope--reveal');
      const observer = new IntersectionObserver((entries, currentObserver) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-visible');
          currentObserver.unobserve(entry.target);
        });
      }, { rootMargin: '0px 0px -10% 0px', threshold: 0.12 });

      cards.forEach((card) => observer.observe(card));
    }
  }
</script>
