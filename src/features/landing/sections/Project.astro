---
import Section from '../../../shared/components/Section.astro';
import Icon from '../../../shared/components/Icon.astro';
import IconBadge from '../../../shared/components/IconBadge.astro';
import Photo from '../../../shared/components/Photo.astro';
import type { LandingContent } from '../content/types';
const { project } = Astro.props as { project: LandingContent['project'] };
---
<Section id="project" eyebrow={project.eyebrow} title={project.title} lead={project.lead} tone="alt">
  <div class="project-challenge">
    <article class="project-challenge__card">
      <IconBadge name={project.challenge.icon} tone="warning" />
      <h3>{project.challenge.title}</h3>
      <p>{project.challenge.text}</p>
      <Photo name="carrinho-notebooks" ratio="16 / 9" alt={project.challenge.photo.alt} caption={project.challenge.photo.caption} />
      <h4 class="project-questions-title">{project.challenge.questionsTitle}</h4>
      <ul class="project-questions" role="list">
        {project.challenge.questions.map((question) => (
          <li><IconBadge name={question.icon} tone="neutral" />{question.text}</li>
        ))}
      </ul>
    </article>
    <article class="project-solution">
      <IconBadge name={project.solution.icon} tone="success" />
      <h3>{project.solution.title}</h3>
      <p>{project.solution.text}</p>
    </article>
  </div>

  <div class="project-block">
    <h3>{project.scopeTitle}</h3>
    <ul class="project-scope" role="list">
      {project.scope.map((item) => (
        <li>
          <IconBadge name={item.icon} tone="neutral" />
          <div><strong>{item.title}</strong><p>{item.text}</p></div>
        </li>
      ))}
    </ul>
  </div>

  <div class="project-block project-block--decisions">
    <h3>{project.decisionsTitle}</h3>
    <ul class="project-decisions" role="list">
      {project.decisions.map((item) => (
        <li>
          <Icon name={item.icon} />
          <div><strong>{item.title}</strong><p>{item.text}</p></div>
        </li>
      ))}
    </ul>
  </div>
</Section>
