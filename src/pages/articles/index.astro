---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const articles = (await getCollection('articles', (a) => a.id.startsWith('pt-br/') && !a.data.draft))
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());
---

<BaseLayout title="Artigos" description="Artigos sobre gestão de equipamentos educacionais e o desenvolvimento do eduAssets." path="articles">
  <main>
    <h1>Artigos</h1>
    {articles.length === 0 && <p>Em breve.</p>}
    <ul>
      {articles.map((a) => (
        <li><a href={`/articles/${a.id.replace(/^pt-br\//, '')}/`}>{a.data.title}</a></li>
      ))}
    </ul>
  </main>
</BaseLayout>
