---
import Section from '../../../shared/components/Section.astro';
import type { LandingContent } from '../content/types';
const { flow } = Astro.props as { flow: LandingContent['flow'] };
---
<Section id="flow" title={flow.title} tone="alt">
  <ol class="steps">
    {flow.steps.map((s) => (
      <li><h3>{s.title}</h3><p>{s.text}</p></li>
    ))}
  </ol>
</Section>
