---
import SiteHeader from '../../shared/components/SiteHeader.astro';
import SiteFooter from '../../shared/components/SiteFooter.astro';
import Hero from './sections/Hero.astro';
import Flow from './sections/Flow.astro';
import Features from './sections/Features.astro';
import Differentials from './sections/Differentials.astro';
import Access from './sections/Access.astro';
import Rfid from './sections/Rfid.astro';
import Project from './sections/Project.astro';
import Tech from './sections/Tech.astro';
import Docs from './sections/Docs.astro';
import FinalCta from './sections/FinalCta.astro';
import Profile from './sections/Profile.astro';
import type { Locale } from '../../core/i18n';
import type { LandingContent } from './content/types';

interface Props { locale: Locale; content: LandingContent }
const { locale, content: c } = Astro.props;
// Keep the navbar short: only the sections people actually jump to.
// Other sections (highlights) are reached by scrolling; add them back here if needed.
const nav = [
  { href: '#project', label: c.nav.project, icon: 'description' },
  { href: '#features', label: c.nav.features, icon: 'dashboard' },
  { href: '#flow', label: c.nav.flow, icon: 'swap_horiz' },
  { href: '#access', label: c.nav.access, icon: 'admin_panel_settings' },
  { href: '#tech', label: c.nav.tech, icon: 'code' },
  { href: '#docs', label: c.nav.docs, icon: 'menu_book' },
  { href: '#profile', label: c.nav.profile, icon: 'badge' },
];
---
<SiteHeader locale={locale} nav={nav} cta={c.hero.primary} />
<main>
  <Hero hero={c.hero} locale={locale} />
  <Project project={c.project} />
  <Flow flow={c.flow} />
  <Features features={c.features} />
  <Differentials differentials={c.differentials} />
  <Access access={c.access} />
  <Rfid rfid={c.rfid} />
  <Tech tech={c.tech} />
  <Docs docs={c.docs} locale={locale} />
  <Profile profile={c.profile} locale={locale} />
  <FinalCta cta={c.cta} />
</main>
<SiteFooter locale={locale} {...c.footer} />
