---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LandingPage from '../../features/landing/LandingPage.astro';
import { en } from '../../features/landing/content/en';
import { softwareApplicationJsonLd } from '../../core/seo/jsonld';

const description = 'Record equipment loans and returns, track laptops and tablets, manage maintenance issues, and export reports in one web system.';
---
<BaseLayout title="eduAssets — school equipment management" description={description} locale="en" alternates={['pt-br', 'en']} jsonLd={softwareApplicationJsonLd(description)}>
  <LandingPage locale="en" content={en} />
</BaseLayout>
