---
import Section from '../../../shared/components/Section.astro';
import IconBadge from '../../../shared/components/IconBadge.astro';
import VideoShot from '../../../shared/components/VideoShot.astro';
import type { LandingContent } from '../content/types';
import Photo from '../../../shared/components/Photo.astro';
const { rfid } = Astro.props as { rfid: LandingContent['rfid'] };
---
<Section id="rfid" eyebrow={rfid.eyebrow} title={rfid.title} lead={rfid.lead}>
  <div class="rfid__video">
    <VideoShot name={rfid.video.key} label={rfid.video.label} alt={rfid.video.alt} hint={rfid.video.hint} caption={rfid.video.caption} />
  </div>
  <div class="rfid__photos">
  <Photo name="rfid-hardware" ratio="16 / 10" alt={rfid.photos[0].alt} caption={rfid.photos[0].caption} />
  <Photo name="rfid-bancada" ratio="16 / 10" alt={rfid.photos[1].alt} caption={rfid.photos[1].caption} />
</div>
  <ol class="grid grid--3 steps" role="list">
    {rfid.steps.map((s) => (
      <li class="card">
        <IconBadge name={s.icon} tone="secondary" />
        <h3>{s.title}</h3>
        <p>{s.text}</p>
      </li>
    ))}
  </ol>
  <p class="note">{rfid.note}</p>
</Section>
