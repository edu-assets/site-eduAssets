---
interface Props { id: string; title: string; lead?: string; tone?: 'plain' | 'alt' }
const { id, title, lead, tone = 'plain' } = Astro.props;
---
<section id={id} class={`section section--${tone}`} aria-labelledby={`${id}-title`}>
  <div class="container">
    <h2 id={`${id}-title`}>{title}</h2>
    {lead && <p class="section__lead">{lead}</p>}
    <slot />
  </div>
</section>
