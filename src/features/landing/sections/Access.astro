---
import Section from '../../../shared/components/Section.astro';
import type { LandingContent } from '../content/types';
const { access } = Astro.props as { access: LandingContent['access'] };
---
<Section id="access" title={access.title} lead={access.lead}>
  <table class="table">
    <thead><tr><th scope="col">{access.headers[0]}</th><th scope="col">{access.headers[1]}</th></tr></thead>
    <tbody>
      {access.levels.map((l) => <tr><th scope="row">{l.name}</th><td>{l.can}</td></tr>)}
    </tbody>
  </table>
  <ul class="checklist">{access.security.map((s) => <li>{s}</li>)}</ul>
</Section>
