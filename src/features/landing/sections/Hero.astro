---
import Button from '../../../shared/components/Button.astro';
import BrandIcon from '../../../shared/components/BrandIcon.astro';
import SocialLinks from '../../../shared/components/SocialLinks.astro';
import { Image } from 'astro:assets';
import notebook from '../../../assets/img/eduAssets_notebook-transparent.png';
import { APP_LOGIN_URL, GITHUB_URL } from '../../../core/config/site';
import type { Locale } from '../../../core/i18n';
import type { LandingContent } from '../content/types';
const { hero, locale } = Astro.props as { hero: LandingContent['hero']; locale: Locale };
const bannerAlt = locale === 'pt-br'
  ? 'eduAssets — gestão de equipamentos escolares'
  : 'eduAssets — school equipment management';
---
<section class="hero">
  <div class="container hero__inner">
    <div class="hero__text">
      <p class="eyebrow">{hero.eyebrow}</p>
      <h1>{hero.title}</h1>
      <span class="divider" aria-hidden="true"></span>
      <p class="hero__lead">{hero.lead}</p>
      <div class="actions">
        <Button href={APP_LOGIN_URL} icon="arrow_forward">{hero.primary}</Button>
         <Button href={GITHUB_URL} variant="secondary" external><BrandIcon name="github" />{hero.secondary}</Button>
      </div>
      <p class="hero__note">{hero.note}</p>
      <SocialLinks locale={locale} />
    </div>
    <div class="hero__visual">
      <figure class="hero__banner">
        <Image
          src={notebook}
          alt={bannerAlt}
          widths={[640, 960, 1280, 1600]}
          sizes="(min-width: 960px) 600px, 100vw"
          loading="eager"
        />
      </figure>
    </div>
  </div>
</section>
