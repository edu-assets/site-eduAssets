---
interface Props { code: 'br' | 'us' }
const { code } = Astro.props;
const id = `flag-${code}`;
---
<svg class="flag" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false">
  <defs><clipPath id={id}><circle cx="12" cy="12" r="12" /></clipPath></defs>
  {code === 'br' ? (
    <g clip-path={`url(#${id})`}>
      <rect width="24" height="24" fill="#009C3B" />
      <polygon points="12,3.6 21.4,12 12,20.4 2.6,12" fill="#FFDF00" />
      <circle cx="12" cy="12" r="4.6" fill="#002776" />
      <path d="M7.7 11.2c2.8-1 5.8-.6 8.6 1.4" stroke="#fff" stroke-width="1" fill="none" />
    </g>
  ) : (
    <g clip-path={`url(#${id})`}>
      <rect width="24" height="24" fill="#fff" />
      {[0, 1, 2, 3, 4, 5, 6].map((i) => <rect y={i * 3.692} width="24" height="1.846" fill="#B22234" />)}
      <rect width="11" height="12.9" fill="#3C3B6E" />
      {[0, 1, 2].map((r) => [0, 1, 2].map((c) => <circle cx={2.4 + c * 3.1} cy={2.6 + r * 3.6} r=".55" fill="#fff" />))}
    </g>
  )}
</svg>
