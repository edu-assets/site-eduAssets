---
import BaseLayout from '../layouts/BaseLayout.astro';
import { softwareApplicationJsonLd } from '../core/seo/jsonld';
import { APP_URL } from '../core/config/site';

const description = 'Sistema de controle de equipamentos educacionais: empréstimos, devoluções, ocorrências e login por cartão RFID.';
---

<BaseLayout title="eduAssets — controle de equipamentos educacionais" description={description} alternates={['pt-br', 'en']} jsonLd={softwareApplicationJsonLd(description)}>
  <main>
    <h1>eduAssets</h1>
    <p>{description}</p>
    <p><a href={APP_URL}>Acessar o sistema</a></p>
  </main>
</BaseLayout>
