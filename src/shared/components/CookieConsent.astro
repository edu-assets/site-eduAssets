---
import type { Locale } from '../../core/i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;
const pt = locale === 'pt-br';
const t = pt
  ? {
      title: 'Cookies de estatísticas',
      text: 'Com o seu aceite, usamos o Google Analytics para entender, de forma agregada, como o site é visitado. Sem aceite, nenhum script do Google é carregado.',
      policy: 'Política de cookies',
      href: '/politica-de-cookies/',
      reject: 'Recusar',
      accept: 'Aceitar',
    }
  : {
      title: 'Statistics cookies',
      text: 'With your consent, we use Google Analytics to understand, in aggregate, how the site is visited. Without consent, no Google script is loaded.',
      policy: 'Cookie policy',
      href: '/en/cookies-policy/',
      reject: 'Decline',
      accept: 'Accept',
    };
---
<div class="cookie-consent" id="cookie-consent" role="region" aria-labelledby="cookie-consent-title" hidden>
  <div class="cookie-consent__text">
    <p class="cookie-consent__title" id="cookie-consent-title">{t.title}</p>
    <p>{t.text} <a href={t.href}>{t.policy}</a></p>
  </div>
  <div class="cookie-consent__actions">
    <button type="button" class="cookie-consent__btn" data-consent-choice="denied">{t.reject}</button>
    <button type="button" class="cookie-consent__btn cookie-consent__btn--primary" data-consent-choice="granted">{t.accept}</button>
  </div>
</div>

<script>
  import { initAnalyticsConsent } from '../../scripts/analytics-consent';
  initAnalyticsConsent();
</script>
